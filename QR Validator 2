# 5) Add simple vitest test
test_ts = """
import { describe, it, expect } from 'vitest';
import { isValidQrPayload } from '../src/lib/qr-validator';

function b64url(s: string): string {
  return Buffer.from(s).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/,'');
}

describe('QR validator', () => {
  it('accepts a valid auth QR with future exp', () => {
    const token = b64url('demo-token');
    const exp = Date.now() + 60_000;
    const url = `veintree://auth?token=${token}&exp=${exp}`;
    const res = isValidQrPayload(url, { requireExp: true });
    expect(res.ok).toBe(true);
  });

  it('rejects wrong scheme', () => {
    const token = b64url('x');
    const url = `https://auth?token=${token}`;
    const res = isValidQrPayload(url, { requireExp: false });
    expect(res.ok).toBe(false);
  });
});
"""
write(f"{root}/app/test/qr-validator.test.ts", test_ts)

